# ===== Wajib =====
# PostgreSQL (lokal, Neon, atau server sendiri). Untuk Neon gunakan URL "pooled".
DATABASE_URL="postgresql://postgres@localhost:5432/laundry_dev"
# Minimal 32 karakter acak. Buat dengan: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
# Zona waktu bisnis (default Asia/Jakarta)
BUSINESS_TZ="Asia/Jakarta"

# ===== Mode demo (opsional) =====
# "true" = saat build/migrasi, isi data contoh + akun demo (owner/demo123 dst). JANGAN untuk produksi.
DEMO_SEED="false"

# ===== WhatsApp API (opsional; tautan wa.me tetap berfungsi tanpa ini) =====
# Penyedia yang didukung: fonnte
WHATSAPP_PROVIDER=""
WHATSAPP_API_TOKEN=""

# ===== Payment gateway QRIS (opsional; QRIS manual tetap berfungsi) =====
# Penyedia yang didukung: midtrans
QRIS_GATEWAY="" 
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# ===== Google Maps (opsional; tautan Maps berfungsi tanpa ini) =====
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
