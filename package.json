  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.73.0",
    "next": "^15.5.29",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.56",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && tsx scripts/deploy.mts && next build",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:deploy": "tsx scripts/deploy.mts",
    "db:reset": "tsx scripts/migrate.mts --reset && tsx scripts/deploy.mts",
    "create-owner": "tsx scripts/create-owner.mts",
    "restore-backup": "tsx scripts/restore-backup.mts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20.9"
  }
}
